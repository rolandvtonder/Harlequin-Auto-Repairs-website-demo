---
import {Image, Picture} from 'astro:assets';
import logo from '../assets/logo.jpg';
import mechanics from '../assets/mechanics-at-work.jpg';
import lifts from '../assets/workshop-lifts.jpg';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import {business} from '../data/site';

const crumbs = [{name: 'About', href: '/about/'}];
const values = [
  {t: 'Explain first', d: 'We tell you what we found and what it costs before any work starts. No surprises on the invoice.'},
  {t: 'Fix it properly', d: 'Quality parts, the right tools and a test drive before your car goes home.'},
  {t: 'Every car', d: 'Hatchbacks, sedans, bakkies and SUVs. Major or minor, petrol or diesel, we do it all.'},
  {t: 'Local', d: 'Based in Brackenhurst and looking after drivers across Alberton.'},
];
const equipment = ['Two-post vehicle lifts', 'Computer diagnostic equipment', 'Tyre changer and wheel balancer', 'A full wall of tyres in stock', 'Fully stocked tool benches'];
---

<Base
  title="About Our Workshop in Brackenhurst"
  description="Harlequin Auto Repairs & Services: an independent workshop on the TotalEnergies forecourt in Brackenhurst, Alberton. All makes, honest quotes."
  breadcrumbs={crumbs}
>
  <PageHero
    compact
    image={mechanics}
    alt="Harlequin mechanics working together under a raised car"
    eyebrow="About us"
    lines={[{t: 'The workshop'}, {t: 'behind the', i: true}, {t: 'diamond.', i: true}]}
    body={`${business.legalName} is an independent workshop in Brackenhurst, Alberton, looking after local drivers and their cars.`}
  />
  <Breadcrumbs items={crumbs} />

  <section class="relative z-10 bg-paper text-ink" aria-labelledby="story">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 py-20 md:grid-cols-[1fr_1.3fr] md:px-14 md:py-28">
      <div class="relative mx-auto w-full max-w-[460px]" data-reveal>
        <Image src={logo} alt={`${business.legalName} logo`} width={920} height={920} class="aspect-square w-full object-cover" />
      </div>
      <div>
        <p class="caps text-red" data-reveal>Our story</p>
        <h2 id="story" class="display mt-4 text-[clamp(40px,5vw,84px)]" data-reveal>
          A bold name. <em class="text-red">Serious</em> workmanship.
        </h2>
        <div class="mt-8 max-w-[640px] space-y-5 text-[18px] leading-relaxed text-ink/85">
          <p data-reveal>
            You will not forget our logo, and we want you to remember our work just as well. Harlequin Auto Repairs &amp; Services handles complete auto repairs and maintenance, from a quick
            minor service to engine and gearbox work, brakes, suspension, aircon, tyres and batteries.
          </p>
          <p data-reveal>
            We are on the TotalEnergies forecourt at {business.address.street}, next to Bracken Gardens and Checkers. You can drop your car off and do your shopping, or wait while we take care
            of tyres and batteries.
          </p>
          <p data-reveal>
            Every job starts with a proper look at the car and a clear explanation. You decide what gets done, and we do it properly.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative z-10 bg-ink" aria-labelledby="values">
    <div class="mx-auto max-w-[1680px] px-5 py-20 md:px-14 md:py-28">
      <h2 id="values" class="display text-[clamp(48px,6.4vw,110px)]" data-reveal>
        <span class="block">How we</span><span class="it block text-gold">work</span>
      </h2>
      <ol class="mt-14 grid gap-[3px] sm:grid-cols-2 lg:grid-cols-4">
        {
          values.map((v, i) => (
            <li class="bg-coal p-8" data-reveal style={`--i:${i}`}>
              <span class="caps text-red">0{i + 1}</span>
              <h3 class="display mt-4 text-[38px]">{v.t}</h3>
              <p class="mt-3 text-white/80">{v.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="relative z-10 bg-paper text-ink" aria-labelledby="equipment">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 py-20 md:grid-cols-2 md:items-center md:px-14 md:py-28">
      <div class="relative aspect-[16/10] overflow-hidden" data-reveal>
        <Picture src={lifts} alt="The Harlequin workshop floor with two lifts, tool benches and the tyre wall" widths={[640, 960, 1400]} sizes="(min-width: 768px) 50vw, 100vw" formats={['avif', 'webp']} class="h-full w-full object-cover" />
      </div>
      <div>
        <p class="caps text-red" data-reveal>Inside the workshop</p>
        <h2 id="equipment" class="display mt-4 text-[clamp(40px,4.8vw,80px)]" data-reveal>Kitted out for the job</h2>
        <ul class="mt-8 border-t border-ink/15">
          {equipment.map((e, i) => <li class="flex min-h-14 items-center gap-4 border-b border-ink/15 text-[18px]" data-reveal style={`--i:${i}`}><span class="inline-block size-2.5 rotate-45 bg-red" aria-hidden="true"></span>{e}</li>)}
        </ul>
        <a href="/gallery/" class="caps mt-8 inline-flex min-h-11 items-center gap-3 border-b-2 border-red hover:text-red" data-reveal>See the gallery</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
