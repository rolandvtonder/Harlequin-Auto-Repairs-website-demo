---
import {Picture} from 'astro:assets';
import heroImg from '../assets/mechanics-at-work.jpg';
import forecourt from '../assets/totalenergies-forecourt.jpg';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Panels from '../components/Panels.astro';
import Base from '../layouts/Base.astro';
import {business, hours, homeFaqs, mapsUrl, services, telHref} from '../data/site';

const facts = [
  {k: 'All makes', v: 'Major & minor repairs on every car, bakkie and SUV'},
  {k: 'Free', v: 'Tyre fitting & balancing'},
  {k: 'Saturdays', v: 'Open 08:00 – 12:00'},
];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}})),
};
---

<Base
  title="Car Repairs in Brackenhurst, Alberton | Harlequin Auto Repairs"
  description="Car repairs & services in Brackenhurst, Alberton: diagnostics, engine, clutch, brakes, suspension, aircon, tyres & batteries. All makes. Call 078 555 3354."
  schema={[faqSchema]}
>
  <PageHero
    image={heroImg}
    alt="Two Harlequin mechanics inspecting the front suspension of a car raised on a lift"
    eyebrow="Brackenhurst · Alberton"
    lines={[{t: 'Major & minor'}, {t: 'repairs.', i: true}, {t: 'Done right in'}, {t: 'Brackenhurst.', i: true}]}
    body="Diagnostics, servicing, engines, clutches, brakes, suspension, aircon, tyres and batteries. One honest workshop for every car, on the TotalEnergies forecourt in Brackenhurst."
  >
    <div class="hero-fade mt-8 flex flex-wrap [@media(min-width:768px)_and_(max-height:760px)]:hidden items-center gap-x-6 gap-y-3 md:ml-[clamp(0px,14vw,260px)]">
      <a href={telHref} class="caps inline-flex min-h-12 items-center gap-3 text-white hover:text-gold">
        <Icon name="phone" size={18} /> {business.phoneDisplay}
      </a>
      <span class="caps text-white/70 data-[state=open]:text-gold" data-open-status hidden></span>
    </div>
  </PageHero>

  <!-- Intro + quick facts -->
  <section class="relative z-10 bg-paper text-ink" aria-labelledby="intro-title">
    <div class="mx-auto max-w-[1680px] px-5 py-20 md:px-14 md:py-32">
      <p class="caps text-red" data-reveal>Harlequin Auto Repairs &amp; Services</p>
      <h2 id="intro-title" class="display mt-5 max-w-[1200px] text-[clamp(40px,5.6vw,96px)]" data-reveal>
        Your local workshop for <em class="text-red">every</em> repair, from a quick oil change to a full engine rebuild.
      </h2>
      <dl class="mt-16 grid gap-[3px] sm:grid-cols-3">
        {
          facts.map((f, i) => (
            <div class="bg-ink p-8 text-white" data-reveal style={`--i:${i}`}>
              <dt class="display text-[clamp(44px,4.4vw,72px)] text-gold">{f.k}</dt>
              <dd class="mt-3 text-[17px] text-white/85">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Panels />

  <!-- Service list -->
  <section class="relative z-10 bg-ink" aria-labelledby="services-title">
    <div class="mx-auto max-w-[1680px] px-5 py-20 md:px-14 md:py-32">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="services-title" class="display text-[clamp(48px,7vw,120px)]" data-reveal>
          <span class="block">Our</span><span class="it block text-gold">services</span>
        </h2>
        <a href="/services/" class="caps inline-flex min-h-11 items-center gap-3 border-b-2 border-red hover:text-gold" data-reveal>
          All services <Icon name="arrow" size={16} />
        </a>
      </div>
      <ol class="mt-14 border-t border-white/15">
        {
          services.map((s, i) => (
            <li class="border-b border-white/15" data-reveal>
              <a href={`/services/${s.slug}/`} class="group grid min-h-20 grid-cols-[3rem_1fr_auto] items-center gap-4 py-5 transition-colors hover:bg-red md:grid-cols-[5rem_1fr_1.2fr_auto] md:px-4">
                <span class="caps text-white/55 group-hover:text-white">{String(i + 1).padStart(2, '0')}</span>
                <span class="display text-[clamp(28px,3.2vw,52px)]">{s.name}</span>
                <span class="hidden text-white/70 group-hover:text-white md:block">{s.includes.slice(0, 3).join(' · ')}</span>
                <Icon name="arrow-up-right" size={26} class="text-white/50 transition-transform duration-300 group-hover:rotate-45 group-hover:text-white" />
              </a>
            </li>
          ))
        }
        <li class="border-b border-white/15" data-reveal>
          <a href="/tyres-batteries/" class="group grid min-h-20 grid-cols-[3rem_1fr_auto] items-center gap-4 py-5 transition-colors hover:bg-red md:grid-cols-[5rem_1fr_1.2fr_auto] md:px-4">
            <span class="caps text-white/55 group-hover:text-white">{String(services.length + 1).padStart(2, '0')}</span>
            <span class="display text-[clamp(28px,3.2vw,52px)]">Tyres &amp; Batteries</span>
            <span class="hidden text-white/70 group-hover:text-white md:block">Free fitting &amp; balancing · Puncture repairs · Batteries</span>
            <Icon name="arrow-up-right" size={26} class="text-white/50 transition-transform duration-300 group-hover:rotate-45 group-hover:text-white" />
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- Find us -->
  <section class="relative z-10 bg-paper text-ink" aria-labelledby="visit-title">
    <div class="mx-auto grid max-w-[1680px] gap-12 px-5 py-20 md:grid-cols-2 md:items-center md:px-14 md:py-32">
      <div class="relative aspect-[4/3] overflow-hidden" data-reveal>
        <Picture
          src={forecourt}
          alt="The TotalEnergies forecourt in Brackenhurst with the Harlequin Auto Repairs sign, next to Bracken Gardens and Checkers"
          widths={[640, 960, 1400]}
          sizes="(min-width: 768px) 50vw, 100vw"
          formats={['avif', 'webp']}
          class="h-full w-full object-cover"
        />
      </div>
      <div>
        <p class="caps text-red" data-reveal>Find us</p>
        <h2 id="visit-title" class="display mt-4 text-[clamp(44px,5.4vw,92px)]" data-reveal>
          <span class="block">On the Total</span><span class="it block text-red">forecourt.</span>
        </h2>
        <p class="mt-6 max-w-[480px] text-[17px] text-ink/80" data-reveal>
          We are at {business.address.street}, {business.address.suburb}, on the TotalEnergies garage next to Bracken Gardens and Checkers. Easy to find, easy to park, and close to
          Brackendowns, Meyersdal and the rest of Alberton.
        </p>
        <dl class="mt-8 max-w-[420px] space-y-2" data-reveal>
          {
            hours.map((h) => (
              <div class="flex justify-between gap-4 border-b border-ink/15 pb-2">
                <dt>{h.days}</dt>
                <dd class="font-semibold">{h.opens ? `${h.opens} – ${h.closes}` : 'Closed'}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-8 flex flex-wrap gap-[3px]" data-reveal>
          <a href={mapsUrl} target="_blank" rel="noopener" class="caps inline-flex min-h-14 items-center gap-3 bg-ink px-7 text-white hover:bg-red">
            <Icon name="pin" size={18} /> Get directions
          </a>
          <a href="/contact/" class="caps inline-flex min-h-14 items-center gap-3 border border-ink/30 px-7 hover:border-red hover:text-red">
            Contact us <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
  <Faq faqs={homeFaqs} title="Good to know" tone="ink" />
</Base>
