---
import {link} from '../../lib/url';
import heroImg from '../../assets/workshop-lifts.jpg';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import {services} from '../../data/site';

const crumbs = [{name: 'Services', href: '/services/'}];
const list = {
  '@type': 'ItemList',
  name: 'Auto repair services at Harlequin Auto Repairs',
  itemListElement: [...services.map((s) => ({name: s.name, url: `/services/${s.slug}/`})), {name: 'Tyres & Batteries', url: '/tyres-batteries/'}].map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: new URL(link(s.url), Astro.site).href,
  })),
};
---

<Base
  title="Car Repair Services in Alberton"
  description="Diagnostics, servicing, engine, gearbox & clutch, brakes, suspension, CV joints, aircon, audio, tyres & batteries at Harlequin Auto Repairs, Alberton."
  breadcrumbs={crumbs}
  schema={[list]}
>
  <PageHero
    compact
    image={heroImg}
    alt="Two cars raised on hydraulic lifts inside the Harlequin Auto Repairs workshop"
    eyebrow="Services"
    lines={[{t: 'Everything'}, {t: 'under the', i: true}, {t: 'hood.', i: true}]}
    body="Major and minor repairs on all makes and models, petrol and diesel. Pick a service to see what is included, or call us and describe the problem."
  />
  <Breadcrumbs items={crumbs} />

  <section class="relative z-10 bg-paper text-ink" aria-labelledby="all-services">
    <div class="mx-auto max-w-[1680px] px-5 py-20 md:px-14 md:py-28">
      <h2 id="all-services" class="sr-only">All services</h2>
      <ul class="grid gap-[3px] sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <li data-reveal style={`--i:${i % 3}`}>
              <a href={link(`/services/${s.slug}/`)} class="group flex h-full min-h-[340px] flex-col justify-between bg-white p-8 transition-colors duration-300 hover:bg-ink hover:text-white">
                <div>
                  <span class="caps text-red group-hover:text-gold">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="display mt-4 text-[clamp(34px,3vw,48px)]">{s.name}</h3>
                  <p class="mt-4 text-ink/75 group-hover:text-white/85">{s.intro.split('. ')[0]}.</p>
                </div>
                <span class="caps mt-8 inline-flex items-center gap-3">
                  View service <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))
        }
        <li data-reveal>
          <a href={link('/tyres-batteries/')} class="diamonds group flex h-full min-h-[340px] flex-col justify-between bg-red p-8 text-white transition-colors duration-300 hover:bg-ink">
            <div>
              <span class="caps text-white/80">{String(services.length + 1).padStart(2, '0')}</span>
              <h3 class="display mt-4 text-[clamp(34px,3vw,48px)]">Tyres &amp; Batteries</h3>
              <p class="mt-4 text-white/90">New tyres with free fitting and balancing, puncture repairs, and batteries tested and fitted.</p>
            </div>
            <span class="caps mt-8 inline-flex items-center gap-3">View service <Icon name="arrow" size={16} /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand title={[{t: 'Not sure what'}, {t: 'it needs?', i: true}]} text="Describe the noise, the smell or the warning light. We will book it in for a check and quote before we touch anything." />
</Base>
