---
import {link} from '../../lib/url';
import type {GetStaticPaths, ImageMetadata} from 'astro';
import {Picture} from 'astro:assets';
import lifts from '../../assets/workshop-lifts.jpg';
import mechanics from '../../assets/mechanics-at-work.jpg';
import tyres from '../../assets/tyre-wall.jpg';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import {business, services, type Service, telHref, waHref} from '../../data/site';

export const getStaticPaths = (() => services.map((service) => ({params: {slug: service.slug}, props: {service}}))) satisfies GetStaticPaths;

const {service} = Astro.props as {service: Service};
const idx = services.findIndex((s) => s.slug === service.slug);
const others = services.filter((s) => s.slug !== service.slug).slice(0, 4);
const next = services[(idx + 1) % services.length];

// Alternate the two workshop photos between service pages.
const images: [ImageMetadata, string][] = [
  [mechanics, 'Harlequin mechanics inspecting the front suspension of a car on a lift'],
  [lifts, 'Two cars raised on lifts inside the Harlequin Auto Repairs workshop'],
];
const [heroImg, heroAlt] = images[idx % 2];
const [sideImg, sideAlt] = idx % 2 ? images[0] : images[1];

const crumbs = [
  {name: 'Services', href: '/services/'},
  {name: service.name, href: `/services/${service.slug}/`},
];
const serviceSchema = {
  '@type': 'Service',
  name: service.name,
  serviceType: service.name,
  description: service.description,
  url: new URL(link(`/services/${service.slug}/`), Astro.site).href,
  provider: {'@id': new URL(link('/#business'), Astro.site).href},
  areaServed: business.areaServed.map((name) => ({'@type': 'Place', name})),
};
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: service.faqs.map((f) => ({'@type': 'Question', name: f.q, acceptedAnswer: {'@type': 'Answer', text: f.a}})),
};
---

<Base title={service.title} description={service.description} breadcrumbs={crumbs} schema={[serviceSchema, faqSchema]}>
  <PageHero compact image={heroImg} alt={heroAlt} eyebrow={service.name} lines={service.hero} body={service.intro} />
  <Breadcrumbs items={crumbs} />

  <section class="relative z-10 bg-paper text-ink" aria-labelledby="about-service">
    <div class="mx-auto grid max-w-[1680px] gap-14 px-5 py-20 md:px-14 md:py-28 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="caps text-red" data-reveal>{service.name} in Brackenhurst, Alberton</p>
        <h2 id="about-service" class="display mt-4 text-[clamp(40px,4.6vw,76px)]" data-reveal>How we handle <em class="text-red">{service.short.toLowerCase()}</em></h2>
        <div class="mt-8 max-w-[680px] space-y-5 text-[18px] leading-relaxed text-ink/85">
          {service.body.map((p) => <p data-reveal>{p}</p>)}
        </div>

        <div class="mt-14 grid gap-[3px] sm:grid-cols-2">
          <div class="bg-ink p-8 text-white" data-reveal>
            <h3 class="caps text-gold">What’s included</h3>
            <ul class="mt-5 space-y-3">
              {
                service.includes.map((x) => (
                  <li class="flex gap-3">
                    <Icon name="check" size={20} class="mt-0.5 text-red" />
                    <span>{x}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="bg-white p-8" data-reveal style="--i:1">
            <h3 class="caps text-red">Signs to look out for</h3>
            <ul class="mt-5 space-y-3">
              {
                service.signs.map((x) => (
                  <li class="flex gap-3">
                    <span class="mt-2 inline-block size-2.5 shrink-0 rotate-45 bg-red" aria-hidden="true" />
                    <span>{x}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <aside class="lg:pt-16" aria-label="Book this service">
        <div class="sticky top-24">
          <div class="relative aspect-[4/3] overflow-hidden" data-reveal>
            <Picture src={sideImg} alt={sideAlt} widths={[640, 960]} sizes="(min-width: 1024px) 40vw, 100vw" formats={['avif', 'webp']} class="h-full w-full object-cover" />
          </div>
          <div class="bg-ink p-8 text-white" data-reveal>
            <p class="display text-[40px]">Book {service.short.toLowerCase()}</p>
            <p class="mt-3 text-white/80">Tell us your make, model and what you have noticed. We will give you a time and a quote.</p>
            <div class="mt-6 flex flex-wrap gap-[3px]">
              <a href={telHref} class="caps inline-flex min-h-12 items-center gap-2 bg-red px-5 hover:bg-white hover:text-ink"><Icon name="phone" size={16} /> {business.phoneDisplay}</a>
              <a href={waHref(`Hi Harlequin Auto Repairs, I would like to book: ${service.name}.`)} target="_blank" rel="noopener" class="caps inline-flex min-h-12 items-center gap-2 bg-white px-5 text-ink hover:bg-gold">
                <Icon name="whatsapp" size={16} /> WhatsApp
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <Faq faqs={service.faqs} title={`${service.short} questions`} tone="ink" />

  <!-- Related services: internal links for visitors and for search engines -->
  <section class="relative z-10 bg-paper text-ink" aria-labelledby="related">
    <div class="mx-auto max-w-[1680px] px-5 py-20 md:px-14">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <h2 id="related" class="display text-[clamp(36px,4vw,64px)]">More from the workshop</h2>
        <a href={link(`/services/${next.slug}/`)} class="caps inline-flex min-h-11 items-center gap-3 border-b-2 border-red hover:text-red">Next: {next.name} <Icon name="arrow" size={16} /></a>
      </div>
      <ul class="mt-10 grid gap-[3px] sm:grid-cols-2 lg:grid-cols-5">
        {
          others.map((s) => (
            <li>
              <a href={link(`/services/${s.slug}/`)} class="group flex min-h-32 h-full flex-col justify-between bg-white p-6 hover:bg-ink hover:text-white">
                <span class="display text-[28px]">{s.name}</span>
                <Icon name="arrow-up-right" size={22} class="mt-4 text-red group-hover:text-gold" />
              </a>
            </li>
          ))
        }
        <li>
          <a href={link('/tyres-batteries/')} class="group relative flex min-h-32 h-full flex-col justify-between overflow-hidden bg-ink p-6 text-white hover:bg-red">
            <Picture src={tyres} alt="" widths={[400]} sizes="300px" formats={['webp']} class="absolute inset-0 h-full w-full object-cover opacity-30" />
            <span class="display relative text-[28px]">Tyres &amp; Batteries</span>
            <Icon name="arrow-up-right" size={22} class="relative mt-4 text-gold" />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
