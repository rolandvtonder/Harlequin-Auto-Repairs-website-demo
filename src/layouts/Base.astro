---
import {link} from '../lib/url';
import '../styles/global.css';
import {getImage} from 'astro:assets';
import logoSrc from '../assets/logo.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import {business, hours, mapsUrl, services} from '../data/site';

interface Props {
  /** Page-specific part of the title; the brand is appended. */
  title: string;
  description: string;
  /** Path under /public for the social share image. */
  ogImage?: string;
  breadcrumbs?: {name: string; href: string}[];
  /** Extra JSON-LD nodes for this page (Service, FAQPage …). */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {title, description, ogImage = '/og-image.jpg', breadcrumbs, schema = [], noindex = false} = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title.includes(business.name) ? title : `${title} | ${business.name}`;
const ogUrl = new URL(link(ogImage), site).href;
const logo = await getImage({src: logoSrc, width: 512, format: 'png'});
const logoUrl = new URL(logo.src, site).href;
const businessId = new URL(link('/#business'), site).href;

// The business itself, on every page, so whichever page Google lands on it
// sees the same name, address, phone and hours.
const localBusiness = {
  '@type': 'AutoRepair',
  '@id': businessId,
  name: business.name,
  alternateName: business.legalName,
  url: new URL(link('/'), site).href,
  logo: logoUrl,
  image: [ogUrl, logoUrl],
  telephone: business.phoneIntl,
  email: business.email,
  priceRange: 'R',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: `${business.address.suburb}, ${business.address.city}`,
    addressRegion: business.address.region,
    postalCode: business.address.postcode,
    addressCountry: business.address.country,
  },
  hasMap: mapsUrl,
  areaServed: business.areaServed.map((name) => ({'@type': 'Place', name})),
  openingHoursSpecification: hours
    .filter((h) => h.opens)
    .map((h) => ({'@type': 'OpeningHoursSpecification', dayOfWeek: h.schema, opens: h.opens, closes: h.closes})),
  sameAs: [business.facebook],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Auto repair services',
    itemListElement: [
      ...services.map((s) => ({'@type': 'Offer', itemOffered: {'@type': 'Service', name: s.name, url: new URL(link(`/services/${s.slug}/`), site).href}})),
      {'@type': 'Offer', itemOffered: {'@type': 'Service', name: 'Tyres & Batteries', url: new URL(link('/tyres-batteries/'), site).href}},
    ],
  },
};

const graph: Record<string, unknown>[] = [
  localBusiness,
  {
    '@type': 'WebSite',
    '@id': new URL(link('/#website'), site).href,
    url: new URL(link('/'), site).href,
    name: business.name,
    publisher: {'@id': businessId},
    inLanguage: 'en-ZA',
  },
  {
    '@type': 'WebPage',
    '@id': `${canonical}#webpage`,
    url: canonical,
    name: fullTitle,
    description,
    isPartOf: {'@id': new URL(link('/#website'), site).href},
    about: {'@id': businessId},
    inLanguage: 'en-ZA',
  },
  ...schema,
];
if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{name: 'Home', href: '/'}, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(link(b.href), site).href,
    })),
  });
}
const jsonLd = JSON.stringify({'@context': 'https://schema.org', '@graph': graph}).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex || import.meta.env.PUBLIC_DEMO ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#0c0b0e" />
    <meta name="geo.region" content="ZA-GP" />
    <meta name="geo.placename" content="Brackenhurst, Alberton" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Inside the Harlequin Auto Repairs workshop in Brackenhurst, Alberton" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={link('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={link('/apple-touch-icon.png')} />
    <link rel="manifest" href={link('/site.webmanifest')} />
    <link rel="sitemap" href={link('/sitemap-index.xml')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,500;0,600;0,700;1,600;1,700&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link caps bg-gold px-5 py-3 text-ink">Skip to content</a>
    <div class="curtain bg-ink" aria-hidden="true"></div>
    <div class="curtain c2 diamonds bg-red" aria-hidden="true"></div>

    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <Menu />
    <div class="grain" aria-hidden="true"></div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
